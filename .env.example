# ACE-Step-1.5-fast: .env の雛形。使うときは .env にコピーして編集する。
#
# 読み込みの順序に注意:
#   run_api_server_fast.sh が export した変数(プロファイルの既定値を含む)が最優先で、
#   .env は「まだ設定されていない変数」だけを補う(override=False)。
#   したがって、スクリプトが既定値を持つ変数(ACESTEP_CONFIG_PATH、ACESTEP_GPU_PROFILE、
#   ACESTEP_DIT_RESIDENCY、ACESTEP_LM_MODEL_PATH など)を変えたいときは、
#   .env ではなくシェルの環境変数で渡す:  ACESTEP_GPU_PROFILE=large ./run_api_server_fast.sh
#   .env が効くのは、スクリプトが触らない以下のような変数。

# --- API の認証(未設定なら認証なし) ---
# ACESTEP_API_KEY=sk-your-secret

# --- チェックポイントの置き場(既定: <repo>/checkpoints) ---
# ACESTEP_CHECKPOINTS_DIR=/mnt/models/acestep

# --- モデルの自動ダウンロード元: auto / huggingface / modelscope ---
# ACESTEP_DOWNLOAD_SOURCE=auto

# --- 一時ファイル・コンパイルキャッシュの置き場(既定: <repo>/.cache/acestep) ---
# ACESTEP_TMPDIR=/data/acestep-tmp

# --- 生成 1 本あたりの打ち切り(秒、既定 600) ---
# ACESTEP_GENERATION_TIMEOUT=600

# --- 起動時にモデルを読まず、最初のリクエストで読む(既定 false。fast は起動時に読む) ---
# ACESTEP_NO_INIT=false

# 参考: run_api_server_fast.sh が既定値を持つ主な変数(シェルで上書きする)
#   ACESTEP_GPU_PROFILE=16gb|large      ACESTEP_API_HOST / ACESTEP_API_PORT
#   ACESTEP_CONFIG_PATH / _PATH2 / _PATH3  ACESTEP_DIT_RESIDENCY / ACESTEP_DIT_RESIDENCY_STORE / ACESTEP_DIT_RESIDENCY_DIR
#   ACESTEP_LM_MODEL_PATH / ACESTEP_LM_BACKEND / ACESTEP_INIT_LLM
#   ACESTEP_OFFLOAD_TO_CPU / ACESTEP_RESIDENT_COMPONENTS / ACESTEP_LM_OFFLOAD_TO_CPU
#   ACESTEP_FUSED_RMSNORM / ACESTEP_DIT_FUSIONS / ACESTEP_QUANTIZATION / ACESTEP_COMPILE_MODEL
#   ACESTEP_VAE_DECODE_CHUNK_SIZE / ACESTEP_MP3_COMPRESSION_LEVEL
#   ACESTEP_QUEUE_WORKERS / ACESTEP_API_WORKERS / ACESTEP_QUEUE_MAXSIZE
# 一覧と意味は 起動コマンド.md を参照。
